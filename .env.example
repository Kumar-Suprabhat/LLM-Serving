# Copy to .env and fill in your own values. .env is gitignored. Do not commit it.
#
# The scripts do not read this file. They call os.getenv, so export the variables
# before you run them:  set -a; source .env; set +a

# Required. Dedicated directory on the GPU host. teardown.sh deletes it recursively.
# Must be a subdirectory you own, not /, /opt, /home, or a user's home directory.
LLMOPT_ROOT=/opt/llmopt

# Optional. Uncomment to override the defaults.
# LLMOPT_LAMBADA_PATH=./samples/lambada_test.jsonl
# LLMOPT_RUNS_DIR=./runs

# Optional. Only for a gated Hugging Face repo. Qwen3-8B is public.
# HF_TOKEN=
